# =====================================================================
#  Nginx para Azure App Service (Linux, PHP 8.x)
#  Se copia al iniciar con deploy/startup.sh
# =====================================================================
server {
    listen 8080;
    listen [::]:8080;
    root /home/site/wwwroot;
    index index.php index.html;
    server_name _;
    port_in_redirect off;

    # Comprobantes de hasta 10 MB (+ margen del formulario)
    client_max_body_size 12M;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ---- Carpetas internas: NUNCA accesibles desde Internet ----
    location ^~ /backend/config/   { return 404; }
    location ^~ /backend/lib/      { return 404; }
    location ^~ /backend/lang/     { return 404; }
    location ^~ /backend/database/ { return 404; }
    location ^~ /backend/scripts/  { return 404; }
    location ^~ /backend/storage/  { return 404; }
    location ^~ /frontend/lang/    { return 404; }
    location ^~ /deploy/           { return 404; }
    location ~ /\.                 { return 404; }
    location ~* \.(md|sql|sh|ini|json|log)$ { return 404; }
    location = /frontend/config.php { return 404; }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ [^/]\.php(/|$) {
        fastcgi_split_path_info ^(.+?\.php)(|/.*)$;
        if (!-f $document_root$fastcgi_script_name) { return 404; }
        fastcgi_pass 127.0.0.1:9000;
        include fastcgi_params;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param QUERY_STRING $query_string;
        fastcgi_intercept_errors on;
        fastcgi_connect_timeout 300;
        fastcgi_send_timeout 300;
        fastcgi_read_timeout 300;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
    }
}
